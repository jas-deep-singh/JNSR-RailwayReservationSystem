generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CoachType {
  SL
  THREE_A
  TWO_A
  ONE_A
  CC
  EC
}

enum BerthType {
  LOWER
  MIDDLE
  UPPER
  SIDE_LOWER
  SIDE_UPPER
  SEAT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum SeatReservationStatus {
  ACTIVE
  CANCELLED
}

enum PaymentProvider {
  MOCK
  SANDBOX
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  role         UserRole   @default(USER)
  bookings     Booking[]
  seatLocks    SeatLock[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

model Station {
  id                  String       @id @default(uuid())
  code                String       @unique
  name                String
  city                String
  state               String
  trainRoutes         TrainRoute[]
  sourceBookings      Booking[]    @relation("BookingSource")
  destinationBookings Booking[]    @relation("BookingDestination")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([city])
  @@index([name])
}

model Train {
  id          String       @id @default(uuid())
  trainNumber String       @unique
  name        String
  active      Boolean      @default(true)
  routes      TrainRoute[]
  coaches     Coach[]
  bookings    Booking[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active])
  @@index([name])
}

model TrainRoute {
  id            String  @id @default(uuid())
  trainId       String
  stationId     String
  sequence      Int
  arrivalTime   String?
  departureTime String?
  dayOffset     Int     @default(0)

  train   Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([trainId, sequence])
  @@unique([trainId, stationId])
  @@index([trainId])
  @@index([stationId])
}

model Coach {
  id          String    @id @default(uuid())
  trainId     String
  coachNumber String
  type        CoachType
  train       Train     @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seats       Seat[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([trainId, coachNumber])
  @@index([trainId])
}

model Seat {
  id           String            @id @default(uuid())
  coachId      String
  seatNumber   String
  berthType    BerthType
  coach        Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  reservations SeatReservation[]
  seatLocks    SeatLock[]
  createdAt    DateTime          @default(now())

  @@unique([coachId, seatNumber])
  @@index([coachId])
}

model Booking {
  id                   String             @id @default(uuid())
  pnr                  String             @unique
  userId               String
  trainId              String
  sourceStationId      String
  destinationStationId String
  journeyDate          DateTime
  status               BookingStatus      @default(PENDING)
  totalAmount          Decimal            @db.Decimal(10, 2)
  expiresAt            DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  train                Train              @relation(fields: [trainId], references: [id], onDelete: Restrict)
  sourceStation        Station            @relation("BookingSource", fields: [sourceStationId], references: [id], onDelete: Restrict)
  destinationStation   Station            @relation("BookingDestination", fields: [destinationStationId], references: [id], onDelete: Restrict)
  passengers           BookingPassenger[]
  seatReservations     SeatReservation[]
  seatLocks            SeatLock[]
  payment              Payment?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([trainId])
  @@index([journeyDate])
  @@index([status])
  @@index([sourceStationId])
  @@index([destinationStationId])
}

model BookingPassenger {
  id                String           @id @default(uuid())
  bookingId         String
  name              String
  age               Int
  gender            String
  seatReservationId String?          @unique
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatReservation   SeatReservation? @relation(fields: [seatReservationId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([bookingId])
}

model SeatReservation {
  id           String                @id @default(uuid())
  bookingId    String
  seatId       String
  fromSequence Int
  toSequence   Int
  status       SeatReservationStatus @default(ACTIVE)
  booking      Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat         Seat                  @relation(fields: [seatId], references: [id], onDelete: Restrict)
  passenger    BookingPassenger?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([bookingId])
  @@index([seatId])
  @@index([seatId, fromSequence, toSequence])
  @@index([status])
}

model SeatLock {
  id           String   @id @default(uuid())
  seatId       String
  userId       String
  bookingId    String?
  fromSequence Int
  toSequence   Int
  expiresAt    DateTime
  seat         Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([seatId])
  @@index([userId])
  @@index([bookingId])
  @@index([expiresAt])
  @@index([seatId, fromSequence, toSequence])
}

model Payment {
  id            String          @id @default(uuid())
  bookingId     String          @unique
  provider      PaymentProvider
  transactionId String?         @unique
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}
